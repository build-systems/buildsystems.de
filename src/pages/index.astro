---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectCarousel from "../components/ProjectCarousel/ProjectCarousel.astro";
import bsTeam from "../assets/buildsystems-team.jpg";
import cardQualitaetsprofil from "../assets/action-card-qualitaetsprofil.svg";
import cardEmissionsprofil from "../assets/action-card-emissionsprofil.svg";
import cardZirkularitaetsprofil from "../assets/action-card-zirkularitaetsprofil.svg";
import Cover from "../components/Cover.astro";
import { getAllPosts } from "../lib/notion/client";
import heroRendering from "../assets/multistory-timber-building.jpg";
import { Image } from "astro:assets";
import LottieAnimation from "astro-integration-lottie/Lottie.astro";
import {
  SITE_TITLE,
  SITE_DESCRIPTION,
  SITE_HEROIMAGE,
  SITE_HEROIMAGEALT,
} from "../consts";
import StickySection from "../components/StickySection.astro";
import ThreePillarsHorizontal from "../components/ThreePillarsHorizontal.astro";
import ThreePillarsVertical from "../components/ThreePillarsVertical.astro";
import ActionLink from "../components/ActionLink.astro";
import LogoCarouselItem from "../components/LogoCarouselItem.astro";
import { getAllOrganizations } from "../lib/notion/client";

const posts = await getAllPosts();

const organizations = await getAllOrganizations();
---

<BaseLayout
  title={SITE_TITLE}
  description={SITE_DESCRIPTION}
  image={SITE_HEROIMAGE}
  imageAlt={SITE_HEROIMAGEALT}
  transition={false}
  preloadFonts={true}
>
  <Cover />

  <Image
    class="hero-image"
    src={heroRendering}
    alt={SITE_HEROIMAGEALT}
    widths={[300, 700, 1000, 1280, 1400, 1600, heroRendering.width]}
    sizes={`(max-width: 300px) 300px, (max-width: 700px) 700px, (max-width: 1000px) 1000px, (max-width: 1280px) 1280px, (max-width: 1400px) 1400px, (max-width: 1600px) 1600px, ${heroRendering.width}px`}
    loading="eager"
  />

  <StickySection>
    <h2>
      gestaltet Systeme, Prozesse und Räume – für lebenswerte Städte und
      klimafreundliche Gebäude.
    </h2>
    <ActionLink
      icon="redirect"
      text="Erstgespräch vereinbaren"
      openOnNewTab={true}
      link="mailto:mail@buildsystems.de"
      widthFitContent={true}
    />
  </StickySection>

  <div class="animation01 horizontal">
    <ThreePillarsHorizontal />
  </div>

  <div class="animation01 vertical">
    <ThreePillarsVertical />
  </div>

  <StickySection>
    <h2>
      realisiert gemeinsam mit Unternehmen, Organisationen und öffentlichen
      Akteur:innen die nachhaltige Transformation der Immobilien- und
      Bauwirtschaft entlang folgender <span
        class="font-secondary text-brand-green">Wirkungsfeldern:</span
      >
    </h2>
  </StickySection>

  <div class="leistungen-nav">
    <a
      href="/leistungen/#strategie"
      class="leistungen-square"
      data-astro-prefetch
    >
      <span class="leistungen-square-text">Strategie</span>
      <span class="leistungen-square-arrow">
        <svg><use xlink:href="/assets/icons.svg#redirect"></use></svg>
      </span>
    </a>
    <a href="/leistungen/#praxis" class="leistungen-square" data-astro-prefetch>
      <span class="leistungen-square-text">Praxis</span>
      <span class="leistungen-square-arrow">
        <svg><use xlink:href="/assets/icons.svg#redirect"></use></svg>
      </span>
    </a>
    <a
      href="/leistungen/#transfer"
      class="leistungen-square"
      data-astro-prefetch
    >
      <span class="leistungen-square-text">Transfer</span>
      <span class="leistungen-square-arrow">
        <svg><use xlink:href="/assets/icons.svg#redirect"></use></svg>
      </span>
    </a>
  </div>

  <StickySection>
    <h2>
      stellt individuelle <span class="font-secondary text-brand-green"
        >Leistungen</span
      > zusammen und bietet passgenaue Lösungen, abgestimmt auf die spezifischen Anforderungen
      und Zielsetzungen des jeweiligen Vorhabens.
    </h2>
    <ActionLink
      icon="redirect"
      text="Leistungen"
      openOnNewTab={true}
      link="/leistungen"
      widthFitContent={true}
    />
  </StickySection>

  <div class="section-container workshop-cards">
    <Image
      class="svg-action-card"
      src={cardQualitaetsprofil}
      alt="Action Card Qualitätsprofil"
    />
    <Image
      class="svg-action-card"
      src={cardEmissionsprofil}
      alt="Action Card Emissionsprofil"
    />
    <Image
      class="svg-action-card"
      src={cardZirkularitaetsprofil}
      alt="Action Card Zirkularitätsprofil"
    />
  </div>

  <StickySection>
    <h2>
      stellt die richtigen Weichen für Ihre zukünftige Strategie, begleitet
      innovative Bauvorhaben in der Praxis und lenkt Informationen wirksam zu
      den relevanten Akteur:innen. Unser <span
        class="font-secondary text-brand-green">Portfolio</span
      > spricht für sich:
    </h2>
    <ActionLink
      icon="redirect"
      text="Portfolio"
      openOnNewTab={true}
      link="/portfolio"
      widthFitContent={true}
    />
  </StickySection>

  <ProjectCarousel posts={posts} />

  <StickySection>
    <h2>
      steht für gelebte Interdisziplinarität: Jeder bringt einen Baustein der
      ganzheitlichen Betrachtung mit ins <span
        class="font-secondary text-brand-green">Team</span
      > ein.
    </h2>
    <ActionLink
      icon="redirect"
      text="Team"
      openOnNewTab={true}
      link="/team"
      widthFitContent={true}
    />
  </StickySection>

  <div class="section-container image-text-grid">
    <div class="options-animation">
      <Image class="image" src={bsTeam} alt="BuildSystems team working" />
    </div>
    <div
      aria-label="Animation: Smart Sustainability Roadmap"
      class="animation02"
    >
      <LottieAnimation
        id="animation02"
        src="animations/five-pillars.json"
        autoplay="visible"
      />
    </div>
  </div>

  <StickySection>
    <h2>
      setzt bei der Umsetzung von Projekten auf die Zusammenarbeit mit
      Organisationen, Partnern und Förderinstitutionen.
    </h2>
  </StickySection>

  {
    organizations.length > 0 && organizations && (
      <div class="logo-marquee-wrapper">
        <div class="logo-marquee-track">
          {organizations.map((organization) => (
            <LogoCarouselItem organization={organization} />
          ))}
          {organizations.map((organization) => (
            <LogoCarouselItem organization={organization} />
          ))}
        </div>
      </div>
    )
  }

  <script>
    // Script for ExpandButton component
    const textsExpandButtons = document.querySelectorAll(
      ".more-text",
    ) as NodeListOf<HTMLElement>;

    textsExpandButtons.forEach((text, i) => {
      const button = document.getElementById("expand-button-0" + (i + 1))!;
      const svgElement = button.querySelector("svg");
      const minusElement = svgElement?.querySelector(".minus");
      const plusElement = svgElement?.querySelector(".plus");

      button.addEventListener("click", () => {
        minusElement?.classList.toggle("hidden");
        plusElement?.classList.toggle("hidden");
        text.classList.toggle("height-max-content");
      });
    });
  </script>

  <style>
    .hero-image {
      position: relative;
      top: 0;
      left: 0;
      min-height: 105svh;
      object-fit: cover;
      -webkit-mask-image: linear-gradient(
        to bottom,
        rgba(0, 0, 0, 1) 90%,
        rgba(0, 0, 0, 0)
      );
      mask-image: linear-gradient(
        to bottom,
        rgba(0, 0, 0, 1) 90%,
        rgba(0, 0, 0, 0)
      );
      z-index: 2;
      user-select: none;
    }

    .animation01 {
      width: 100%;
      padding-top: 2rem;
      padding-bottom: 2rem;
      padding-left: var(--left-padding-general);
      padding-right: var(--right-padding-general);
    }

    .animation01.vertical {
      display: none;
    }

    .carousel-container {
      min-height: 30svh;
      width: 100%;
      padding-left: var(--left-padding-general);
      padding-right: var(--right-padding-general);
      margin-top: 5svh;
    }

    .animation02 {
      margin-top: -2rem;
      margin-bottom: -4rem;
      width: 100%;
    }

    .workshop-cards {
      width: calc(
        100% - var(--left-padding-general) - var(--right-padding-general)
      );
      display: flex;
      justify-content: space-around;
      align-items: center;
    }

    .svg-action-card {
      width: clamp(80px, 20svw, 300px);
      justify-self: center;
    }

    .image {
      border-radius: var(--card-border-radius);
    }

    .leistungen-nav {
      display: flex;
      gap: 1rem;
      width: calc(
        100% - var(--left-padding-general) - var(--right-padding-general)
      );
      margin-left: var(--left-padding-general);
      margin-right: var(--right-padding-general);
      margin-bottom: 2rem;
    }

    .leistungen-square {
      flex: 1;
      aspect-ratio: 1 / 1;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 1.2rem;
      background-color: transparent;
      border: 1px solid var(--text-main);
      border-radius: 0.4rem;
      text-decoration: none;
      color: var(--text-main);
      position: relative;
      overflow: hidden;
      transition:
        transform 0.25s ease,
        box-shadow 0.25s ease;
    }

    .leistungen-square:hover {
      transform: scale(1.03);
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.35);
    }

    .leistungen-square-text {
      font-family: var(--font-family-primary);
      font-size: 1.3rem;
      font-weight: 500;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      z-index: 1;
    }

    .leistungen-square-arrow {
      opacity: 0;
      transform: translateX(-4px);
      transition:
        opacity 0.2s ease,
        transform 0.2s ease;
    }

    .leistungen-square-arrow svg {
      width: 16px;
      height: 16px;
      fill: var(--text-main);
    }

    .leistungen-square:hover .leistungen-square-arrow {
      opacity: 1;
      transform: translateX(0);
    }

    @media (max-width: 1280px) {
      .animation01 {
        padding-left: calc(var(--left-padding-desktop) - 40px);
        padding-right: 5%;
      }

      .carousel-container {
        padding-left: var(--left-padding-desktop);
        padding-right: var(--right-padding-desktop);
      }

      .workshop-cards {
        width: calc(
          100% - var(--left-padding-desktop) - var(--right-padding-desktop)
        );
      }

      .leistungen-nav {
        width: calc(
          100% - var(--left-padding-desktop) - var(--right-padding-desktop)
        );
        margin-left: var(--left-padding-desktop);
        margin-right: var(--right-padding-desktop);
      }
    }

    @media (max-width: 920px) {
      .animation01.vertical {
        display: block;
        width: 50%;
      }

      .animation01.horizontal {
        display: none;
      }

      .animation01 {
        padding-left: var(--left-padding-tablet);
      }

      .carousel-container {
        padding-left: var(--left-padding-tablet);
        padding-right: var(--right-padding-tablet);
      }

      .animation02 {
        padding-left: var(--left-padding-tablet);
        padding-right: var(--right-padding-tablet);
        width: 100%;
      }

      .workshop-cards {
        width: calc(
          100% - var(--left-padding-tablet) - var(--right-padding-tablet)
        );
        margin-left: var(--left-padding-tablet);
        margin-right: var(--right-padding-tablet);
      }

      .svg-action-card {
        width: clamp(80px, 26svw, 300px);
      }

      .leistungen-nav {
        width: calc(
          100% - var(--left-padding-desktop) - var(--right-padding-desktop)
        );
        margin-left: var(--left-padding-desktop);
        margin-right: var(--right-padding-desktop);
      }
    }

    @media (max-width: 640px) {
      .carousel-container {
        padding-left: var(--left-padding-tablet);
        padding-right: var(--right-padding-tablet);
      }

      .animation02 {
        width: 110%;
        margin: 0;
        padding: 0;
      }

      .workshop-cards {
        flex-direction: column;
        gap: 3rem;
      }

      .svg-action-card {
        width: clamp(80px, 60svw, 300px);
      }

      .leistungen-nav {
        flex-direction: column;
        margin-left: var(--left-padding-tablet);
        margin-right: var(--right-padding-tablet);
      }

      .leistungen-square {
        aspect-ratio: auto;
        padding: 1rem;
      }
    }

    @media (max-width: 420px) {
      .carousel-container {
        padding-left: var(--left-padding-mobile);
        padding-right: var(--right-padding-mobile);
      }

      .animation02 {
        width: 105%;
        margin: 0;
        padding: 0;
      }

      .workshop-cards {
        width: calc(
          100% - var(--left-padding-mobile) - var(--right-padding-mobile)
        );
        margin-left: var(--left-padding-mobile);
        margin-right: var(--right-padding-mobile);
        margin-top: 2rem;
      }

      .svg-action-card {
        width: clamp(80px, 70svw, 300px);
      }

      .leistungen-nav {
        margin-left: var(--left-padding-mobile);
        margin-right: var(--right-padding-mobile);
      }
    }

    /* Logo Marquee */
    .logo-marquee-wrapper {
      width: 100%;
      overflow: hidden;
      padding: 2rem 0;
      -webkit-mask-image: linear-gradient(
        to right,
        transparent 0%,
        black 8%,
        black 92%,
        transparent 100%
      );
      mask-image: linear-gradient(
        to right,
        transparent 0%,
        black 8%,
        black 92%,
        transparent 100%
      );
    }

    .logo-marquee-track {
      display: flex;
      gap: 1.5rem;
      width: max-content;
      animation: marquee-scroll 40s linear infinite;
    }

    .logo-marquee-track:hover {
      animation-play-state: paused;
    }

    @keyframes marquee-scroll {
      0% {
        transform: translateX(0);
      }
      100% {
        transform: translateX(-50%);
      }
    }
  </style>
</BaseLayout>
