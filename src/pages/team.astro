---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectCarousel from "../components/ProjectCarousel/ProjectCarousel.astro";
import {
  getAllPartners,
  getAllPeople,
  getAllPosts,
} from "../lib/notion/client";
import StickySection from "../components/StickySection.astro";
import PersonCard from "../components/PersonCard.astro";
import PartnersCard from "../components/PartnersCard.astro";

const title = "BuildSystems | Team";
const description =
  "BuildSystems erschließt Potenziale der Umweltentlastung ganzheitlich. Deshalb beraten wir Sie toolunabhängig im interdisziplinären Team aus Nachhaltigkeits- und Softwarespezialisten.";
const image = "/images/buildsystems-team-steiermark.jpg";
const imageAlt = "BuildSystems team working";

const people = await getAllPeople();

const partners = await getAllPartners();

const posts = await getAllPosts();
---

<BaseLayout
  title={title}
  description={description}
  image={image}
  imageAlt={imageAlt}
>
  <StickySection>
    <h2>führt Kompetenzen, Prozesse und Tools zusammen. Wir vertreten nicht nur einen integralen Prozess in der Planung, wir leben Interdisziplinarität im Team: Jeder bringt einen Baustein der ganzheitlichen Betrachtung mit ein.</h2>
  </StickySection>

  {
    people.length > 0 && people && (
      <div class="section-container">
        <h2>Team</h2>
        <div class="mb-24 grid gap-2 xl:grid-cols-2">
          {
            people.map((person) => {
              return <PersonCard person={person} />;
            })
          }
        </div>
      </div>
    )
  }
  {
    partners.length > 0 && partners && (
    <StickySection>
      <h2>denkt Projekte von Anfang an interdisziplinär. Deshalb arbeiten wir mit starken Partnern aus den Bereichen Kommunikation, Fachplanung und Software.</h2>
    </StickySection>
      <div class="section-container">
        <h2>Partner</h2>
        <div class="mb-24 grid gap-2 xl:grid-cols-2">
          {
            partners.map((partner) => {
              return <PartnersCard partner={partner} />;
            })
          }
        </div>
      </div>
    )
  }
  <ProjectCarousel posts={posts} />
</BaseLayout>

<style>
  .cards-container {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.5rem;
    z-index: 2;
    margin-bottom: 20svh;
  }

  @media (max-width: 920px) {
    .cards-container {
      grid-template-columns: repeat(1, minmax(0, 1fr));
    }
  }
</style>
