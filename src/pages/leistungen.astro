---
import BaseLayout from "../layouts/BaseLayout.astro";
import StickySection from "../components/StickySection.astro";
import OrbitAnimation from "../components/OrbitAnimation/OrbitAnimation.astro";

const title = "BuildSystems | Leistungen";
const description =
  "BuildSystems vereint 3 Wirkungsfelder, um nachhaltige Innovationen im Bau- und Immobiliensektor von der Vision bis zur Umsetzung wirksam voranzubringen.";
const image = "/images/services-smart-sustainability-roadmap.png";
const imageAlt = "Cover of the Smart Sustainability Roadmap";
---

<BaseLayout
  title={title}
  description={description}
  image={image}
  imageAlt={imageAlt}
>
  <StickySection>
    <h2>
      vereint <span class="font-secondary text-brand-green"
        >drei Wirkungsfelder,</span
      > um nachhaltige Innovationen im Bau- und Immobiliensektor von der Vision bis
      zur Umsetzung wirksam voranzubringen.
    </h2>
  </StickySection>

  <OrbitAnimation />
</BaseLayout>
