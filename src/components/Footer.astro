---
import ActionLink from "./ActionLink.astro";

---

<div class="mt-[10svh] sm:mt-[20svh] relative flex flex-col items-center">
  <footer
    class="flex flex-col grow shrink-0 w-[calc(100%-(var(--left-padding-mobile)*2))] sm:w-[calc(100%-2rem)] bg-(--background-cards) mb-(--left-padding-mobile) sm:mb-4 p-8 rounded-[0.6rem] z-2"
  >
    <div class="flex grow justify-between items-center">
      <div class="flex">
        <div class="flex w-full flex-col">
          <div class="flex justify-between">
            <section
              class="relative flex flex-col text-left gap-4"
              aria-label="Kontakt, LinkedIn and Instagram"
            >
              <div class="flex flex-col w-fit gap-[0.3rem] z-3">
                <h3 class="text-[1.4rem] text-white">
                  Sie haben weitere Fragen?
                </h3>
                <ActionLink
                  href="mailto:mail@buildsystems.de"
                  justifyCenter={true}
                  >Schreiben Sie uns eine Mail!</ActionLink
                >
              </div>
              <div class="leading-none text-balance py-4">
                Wir freuen uns auf den Austausch mit Ihnen!
              </div>
              <div class="pb-4">
                <address
                  class="not-italic flex flex-col text-base leading-[120%] gap-2"
                >
                  <div class="flex gap-[0.5em]">
                    <a
                      href="https://www.linkedin.com/company/build-systems-de/"
                      target="_blank"
                      aria-label="Follow BuildSystems on LinkedIn"
                      class="flex no-underline"
                    >
                      <svg
                        class="w-4 aspect-square fill-(--text-secondary)"
                      >
                        <use xlink:href="/assets/icons.svg#linkedin"></use>
                      </svg>
                    </a>
                    <a
                      href="https://www.instagram.com/buildsystems.de/"
                      target="_blank"
                      aria-label="Follow BuildSystems on Instagram"
                      class="flex no-underline"
                    >
                      <svg
                        class="w-4 aspect-square fill-(--text-secondary)"
                        ><use xlink:href="/assets/icons.svg#instagram"
                        ></use></svg
                      >
                    </a>
                  </div>
                </address>
              </div>
              <address
                class="not-italic flex flex-col text-base leading-[120%] gap-2"
              >
                BuildSystems GmbH<br />Furtanger 4<br />D-82205 Gilching
              </address>
            </section>
          </div>
        </div>
      </div>
      <nav
        class="leading-[120%] text-base whitespace-pre-line text-right content-end [&>a]:flex [&>a]:no-underline [&>a]:justify-end"
      >
        <a href="/"> Home</a>
        <a href="/leistungen"> Leistungen</a>
        <a href="/portfolio"> Portfolio</a>
        <a href="/team"> Team</a>
        <a href="/impressum" class="w-min flex-wrap">
          Impressum Datenschutzerklärung</a
        >
      </nav>
    </div>
    <section
      class="flex grow flex-col justify-between"
    >
      <div class="flex justify-end mt-0 p-0 text-left text-[clamp(0.8rem,3.7svw,2.65rem)] font-medium">
        BuildSmart. BuildSustainable. BuildSystems!
      </div>
    </section>
  </footer>
</div>
