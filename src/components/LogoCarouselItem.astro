---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import type { OrganizationCard } from "../lib/notion-interfaces";
import { getPhotoPath } from "../lib/blog-helpers";

interface Props {
  organization: OrganizationCard;
}

const { organization } = Astro.props;

const images = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/notion/**/*.{jpeg,jpg,png,tiff,webp,gif,svg,avif}",
);

const imagePath = getPhotoPath(organization.Photo?.Url!, "organizations");
const imageSrc = images[imagePath] ? images[imagePath]() : null;

const name = organization.Name;
const website = organization.Website;
const linkedin = organization.LinkedIn;
const linkTarget = website || linkedin || "#";
---

<a
  href={linkTarget}
  target="_blank"
  rel="noopener noreferrer"
  aria-label={"Visit " + name}
  class="logo-marquee-item"
>
  {
    imageSrc ? (
      <Image src={imageSrc} alt={`${name} logo`} class="logo-marquee-img" />
    ) : (
      <div class="logo-marquee-placeholder">No Image</div>
    )
  }
</a>

<style>
  .logo-marquee-item {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    padding: 1rem 2rem;
    transition:
      box-shadow 0.3s ease,
      brightness 0.3s ease;
  }

  .logo-marquee-item:hover {
    filter: brightness(1.05);
  }

  .logo-marquee-img {
    height: 3.5rem;
    width: auto;
    max-width: 10rem;
    object-fit: contain;
  }

  .logo-marquee-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 3.5rem;
    padding: 0 1rem;
    border-radius: 9999px;
    background-color: #e5e7eb;
    font-size: 0.875rem;
    color: #6b7280;
  }
</style>
