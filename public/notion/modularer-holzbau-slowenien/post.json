    {
      "Id": "230cc54c-ec6d-8011-8ee3-dc330dc83a0c",
      "Type": "paragraph",
      "HasChildren": false,
      "ParentId": "22ccc54c-ec6d-8080-a789-ff531d30daae",
      "Paragraph": {
        "RichTexts": [
          {
            "Annotation": {
              "Bold": false,
              "Italic": false,
              "Strikethrough": false,
              "Underline": false,
              "Code": false,
              "Color": "default"
            },
            "PlainText": "Mit dem neuen Haus entsteht nicht nur zusätzlicher Gästeraum, sondern ein weiteres Element in der langfristigen Entwicklungsstrategie des Betriebs. Architektur wird hier nicht als isoliertes Objekt, sondern als funktionaler Bestandteil eines integrierten Gesamtsystems verstanden im Zusammenspiel mit Landwirtschaft, Tourismus und ökologischer Baukultur.",
            "Href": null,
            "Text": {
              "Content": "Mit dem neuen Haus entsteht nicht nur zusätzlicher Gästeraum, sondern ein weiteres Element in der langfristigen Entwicklungsstrategie des Betriebs. Architektur wird hier nicht als isoliertes Objekt, sondern als funktionaler Bestandteil eines integrierten Gesamtsystems verstanden im Zusammenspiel mit Landwirtschaft, Tourismus und ökologischer Baukultur."
            }
          }
        ],
        "Color": "default"
      }
    },
