    {
      "Id": "33ccc54c-ec6d-80b8-b521-d8448ca34a6e",
      "Type": "paragraph",
      "HasChildren": false,
      "ParentId": "309cc54c-ec6d-8017-b581-d7c4bf00056d",
      "Paragraph": {
        "RichTexts": [
          {
            "Annotation": {
              "Bold": false,
              "Italic": false,
              "Strikethrough": false,
              "Underline": false,
              "Code": false,
              "Color": "default"
            },
            "PlainText": "Zentraler Bestandteil des Konzepts ist ein flexibles Raumgefüge: Leichte Trennwände, inspiriert von japanischen Shoji-Elementen, ermöglichen unterschiedliche Nutzungsszenarien – vom konzentrierten Arbeitsalltag bis hin zu Veranstaltungen. Vorhänge und transluzente Flächen zonieren den Raum, ohne seine Offenheit zu verlieren.",
            "Href": null,
            "Text": {
              "Content": "Zentraler Bestandteil des Konzepts ist ein flexibles Raumgefüge: Leichte Trennwände, inspiriert von japanischen Shoji-Elementen, ermöglichen unterschiedliche Nutzungsszenarien – vom konzentrierten Arbeitsalltag bis hin zu Veranstaltungen. Vorhänge und transluzente Flächen zonieren den Raum, ohne seine Offenheit zu verlieren."
            }
          }
        ],
        "Color": "default"
      }
    },
    {
