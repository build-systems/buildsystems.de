              "Code": false,
              "Color": "default"
            },
            "PlainText": "Einfach Bauen – kosteneffizient, experimentell, zukunftsfähig",
            "Href": null,
            "Text": {
              "Content": "Einfach Bauen – kosteneffizient, experimentell, zukunftsfähig"
