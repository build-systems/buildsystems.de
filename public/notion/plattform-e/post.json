              "Underline": false,
              "Code": false,
              "Color": "default"
            },
            "PlainText": "Was ist der Gebäudetyp E?",
            "Href": null,
            "Text": {
              "Content": "Was ist der Gebäudetyp E?"
            }
          }
        ],
        "Color": "default"
      }
    },
    {
      "Id": "224cc54c-ec6d-80e9-9f56-ce6f9ad2a726",
      "Type": "paragraph",
      "HasChildren": false,
      "ParentId": "1accc54c-ec6d-80d3-b4f8-d39231fbab3d",
      "Paragraph": {
        "RichTexts": [
          {
            "Annotation": {
              "Bold": false,
              "Italic": false,
              "Strikethrough": false,
              "Underline": false,
              "Code": false,
              "Color": "default"
            },
            "PlainText": "Der Gebäudetyp E steht für das „Einfach-Bauen“: ein Konzept, das bewusst auf freiwillige Komfort- und Technikstandards verzichtet, ohne gesetzliche Mindestanforderungen zu unterschreiten. Durch diese radikale Vereinfachung lassen sich Planungsaufwand, Baukosten und Materialeinsatz deutlich reduzieren – bei gleichzeitig hoher funktionaler und gestalterischer Qualität.",
            "Href": null,
            "Text": {
              "Content": "Der Gebäudetyp E steht für das „Einfach-Bauen“: ein Konzept, das bewusst auf freiwillige Komfort- und Technikstandards verzichtet, ohne gesetzliche Mindestanforderungen zu unterschreiten. Durch diese radikale Vereinfachung lassen sich Planungsaufwand, Baukosten und Materialeinsatz deutlich reduzieren – bei gleichzeitig hoher funktionaler und gestalterischer Qualität."
            }
          }
        ],
        "Color": "default"
      }
    },
    {
      "Id": "224cc54c-ec6d-8039-a4a7-fd990b101dd6",
      "Type": "paragraph",
      "HasChildren": false,
      "ParentId": "1accc54c-ec6d-80d3-b4f8-d39231fbab3d",
      "Paragraph": {
        "RichTexts": [
          {
            "Annotation": {
              "Bold": false,
              "Italic": false,
              "Strikethrough": false,
              "Underline": false,
              "Code": false,
              "Color": "default"
            },
            "PlainText": "Aktuell erproben 19 Pilotprojekte in Bayern die Umsetzung des Gebäudetyps E – wissenschaftlich begleitet von der TU Braunschweig, die Einsparpotenziale und Auswirkungen auf Nachhaltigkeit, Bauzeit und Wirtschaftlichkeit untersucht.",
            "Href": null,
            "Text": {
              "Content": "Aktuell erproben 19 Pilotprojekte in Bayern die Umsetzung des Gebäudetyps E – wissenschaftlich begleitet von der TU Braunschweig, die Einsparpotenziale und Auswirkungen auf Nachhaltigkeit, Bauzeit und Wirtschaftlichkeit untersucht."
            }
          }
        ],
        "Color": "default"
      }
    },
