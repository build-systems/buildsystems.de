              "Strikethrough": false,
              "Underline": false,
              "Code": false,
              "Color": "default"
            },
            "PlainText": "Warum braucht es einfaches und experimentelles Bauen?",
            "Href": null,
            "Text": {
              "Content": "Warum braucht es einfaches und experimentelles Bauen?"
            }
          }
        ],
        "Color": "default"
      }
    },
    {
      "Id": "224cc54c-ec6d-8015-9fd7-dc1ca7c17967",
      "Type": "paragraph",
      "HasChildren": false,
      "ParentId": "1accc54c-ec6d-80d3-b4f8-d39231fbab3d",
      "Paragraph": {
        "RichTexts": [
          {
            "Annotation": {
              "Bold": false,
              "Italic": false,
              "Strikethrough": false,
              "Underline": false,
              "Code": false,
              "Color": "default"
            },
            "PlainText": "Die Bauindustrie steht vor massiven Herausforderungen: steigende Baukosten, überbordende Normen, Fachkräftemangel und ein akuter Wohnraummangel. Gleichzeitig erfordern Klimaziele und neue Regulierungen wie die EU-Taxonomie ein radikales Umdenken.",
            "Href": null,
            "Text": {
              "Content": "Die Bauindustrie steht vor massiven Herausforderungen: steigende Baukosten, überbordende Normen, Fachkräftemangel und ein akuter Wohnraummangel. Gleichzeitig erfordern Klimaziele und neue Regulierungen wie die EU-Taxonomie ein radikales Umdenken."
            }
          }
        ],
        "Color": "default"
      }
    },
    {
      "Id": "224cc54c-ec6d-8044-a9e1-e586ec114e60",
      "Type": "paragraph",
      "HasChildren": false,
      "ParentId": "1accc54c-ec6d-80d3-b4f8-d39231fbab3d",
      "Paragraph": {
        "RichTexts": [
          {
            "Annotation": {
              "Bold": false,
              "Italic": false,
              "Strikethrough": false,
              "Underline": false,
              "Code": false,
              "Color": "default"
            },
            "PlainText": "Einfaches Bauen bietet hier einen konkreten Lösungsansatz: weniger Komplexität, mehr Klarheit – und vor allem mehr Handlungsspielraum für innovative, ressourcenschonende Baukonzepte, die den sozialen und ökologischen Anforderungen unserer Zeit gerecht werden.",
            "Href": null,
            "Text": {
              "Content": "Einfaches Bauen bietet hier einen konkreten Lösungsansatz: weniger Komplexität, mehr Klarheit – und vor allem mehr Handlungsspielraum für innovative, ressourcenschonende Baukonzepte, die den sozialen und ökologischen Anforderungen unserer Zeit gerecht werden."
            }
          }
        ],
        "Color": "default"
      }
