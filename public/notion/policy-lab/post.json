    {
      "Id": "34acc54c-ec6d-805b-98d9-f8d604768b14",
      "Type": "paragraph",
      "HasChildren": false,
      "ParentId": "21acc54c-ec6d-801e-8e99-e6ea1b75f593",
      "Paragraph": {
        "RichTexts": [
          {
            "Annotation": {
              "Bold": false,
              "Italic": false,
              "Strikethrough": false,
              "Underline": false,
              "Code": false,
              "Color": "default"
            },
            "PlainText": "Die Dekarbonisierung des Bausektors ist keine Zukunftsaufgabe mehr – sie ist eine unmittelbare Notwendigkeit. Während sich politische Ziele zunehmend verschärfen, fehlt es in der Praxis oft noch an klaren, verbindlichen Rahmenbedingungen.",
            "Href": null,
            "Text": {
              "Content": "Die Dekarbonisierung des Bausektors ist keine Zukunftsaufgabe mehr – sie ist eine unmittelbare Notwendigkeit. Während sich politische Ziele zunehmend verschärfen, fehlt es in der Praxis oft noch an klaren, verbindlichen Rahmenbedingungen."
            }
          }
        ],
        "Color": "default"
      }
    },
