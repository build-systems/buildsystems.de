    {
      "Id": "374cc54c-ec6d-8005-b61e-cce120262204",
      "Type": "paragraph",
      "HasChildren": false,
      "ParentId": "374cc54c-ec6d-8086-b1ff-c6ac8072f74c",
      "Paragraph": {
        "RichTexts": [
          {
            "Annotation": {
              "Bold": false,
              "Italic": false,
              "Strikethrough": false,
              "Underline": false,
              "Code": false,
              "Color": "default"
            },
            "PlainText": "Endliche Ressourcen vertragen kein lineares Bauen. Daher rücken zirkuläre Baukonzepte und geschlossene Materialkreisläufe zunehmend in den Mittelpunkt einer nachhaltigen Bauwirtschaft.",
            "Href": null,
            "Text": {
              "Content": "Endliche Ressourcen vertragen kein lineares Bauen. Daher rücken zirkuläre Baukonzepte und geschlossene Materialkreisläufe zunehmend in den Mittelpunkt einer nachhaltigen Bauwirtschaft."
            }
          }
        ],
        "Color": "default"
      }
    },
    {
      "Id": "374cc54c-ec6d-8081-b25c-e638e88802cb",
      "Type": "paragraph",
      "HasChildren": false,
      "ParentId": "374cc54c-ec6d-8086-b1ff-c6ac8072f74c",
      "Paragraph": {
        "RichTexts": [
          {
            "Annotation": {
              "Bold": false,
              "Italic": false,
              "Strikethrough": false,
              "Underline": false,
              "Code": false,
              "Color": "default"
            },
            "PlainText": "Im Rahmen einer Gastveranstaltung an der Hochschule Weihenstepahn-Triesdorf stellte Martin Bittmann, als ",
            "Href": null,
            "Text": {
              "Content": "Im Rahmen einer Gastveranstaltung an der Hochschule Weihenstepahn-Triesdorf stellte Martin Bittmann, als "
            }
          },
          {
            "Annotation": {
              "Bold": false,
              "Italic": false,
              "Strikethrough": false,
              "Underline": false,
              "Code": false,
              "Color": "default"
            },
            "PlainText": "freier ",
            "Href": null,
            "Text": {
              "Content": "freier "
            }
          },
          {
            "Annotation": {
              "Bold": false,
              "Italic": false,
              "Strikethrough": false,
              "Underline": false,
              "Code": false,
              "Color": "default"
            },
            "PlainText": "Berater der Bayerischen Architektenkammer (BEN), unter dem Titel “Zirkuläres Planen und Bauen als Mehrwert für Kommunen - Strategien und Umsetzung einer lokalen Kreislaufwirtschaft” die Grundlagen und Potenziale des zirkulären Bauens vor. \nIm Mittelpunkt stand die Frage, wie Gebäude künftig geplant werden können, damit die eingesetzten Materialien auch nach ihrer Nutzung als Ressourcen verfügbar bleiben und in neue Wertschöpfungskreisläufe zurückgeführt werden können.",
            "Href": null,
            "Text": {
              "Content": "Berater der Bayerischen Architektenkammer (BEN), unter dem Titel “Zirkuläres Planen und Bauen als Mehrwert für Kommunen - Strategien und Umsetzung einer lokalen Kreislaufwirtschaft” die Grundlagen und Potenziale des zirkulären Bauens vor. \nIm Mittelpunkt stand die Frage, wie Gebäude künftig geplant werden können, damit die eingesetzten Materialien auch nach ihrer Nutzung als Ressourcen verfügbar bleiben und in neue Wertschöpfungskreisläufe zurückgeführt werden können."
            }
          }
        ],
        "Color": "default"
      }
    },
