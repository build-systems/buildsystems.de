    {
      "Id": "33ccc54c-ec6d-80d4-a7af-f7a75c8a9455",
      "Type": "bulleted_list_item",
      "HasChildren": false,
      "ParentId": "303cc54c-ec6d-8064-a74e-ed88eb8a3faf",
      "BulletedListItem": {
        "RichTexts": [
          {
            "Annotation": {
              "Bold": false,
              "Italic": false,
              "Strikethrough": false,
              "Underline": false,
              "Code": false,
              "Color": "default"
            },
            "PlainText": "Vergleichbarkeit und Skalierbarkeit: Je detaillierter die zur Verfügung gestellten Informationen, desto leichter die Übertragbarkeit auf andere Projekte. Denn es ist unser Ziel, Erkenntnisse aus realisierten Projekten kommunizierbar, anwendbar und reproduzierbar zu machen.",
            "Href": null,
