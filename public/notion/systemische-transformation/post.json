    },
    {
      "Id": "34acc54c-ec6d-808c-855a-e533f0efaebd",
      "Type": "paragraph",
      "HasChildren": false,
      "ParentId": "28ccc54c-ec6d-80fb-9d95-cff4eafc32f0",
      "Paragraph": {
        "RichTexts": [
          {
            "Annotation": {
              "Bold": false,
              "Italic": false,
              "Strikethrough": false,
              "Underline": false,
              "Code": false,
              "Color": "default"
            },
            "PlainText": "In der anschließenden Diskussion wurde deutlich, wie stark sich auch das Berufsbild verändert. Architektur wird zunehmend als Schnittstelle zwischen Gestaltung, Prozessdenken und unternehmerischer Verantwortung verstanden. Viele Studierende interessieren sich für Rollen jenseits klassischer Planung – als Impulsgeber:innen für neue Geschäftsmodelle, als Vermittler:innen zwischen Disziplinen oder als Treiber:innen systemischer Veränderung.",
            "Href": null,
            "Text": {
              "Content": "In der anschließenden Diskussion wurde deutlich, wie stark sich auch das Berufsbild verändert. Architektur wird zunehmend als Schnittstelle zwischen Gestaltung, Prozessdenken und unternehmerischer Verantwortung verstanden. Viele Studierende interessieren sich für Rollen jenseits klassischer Planung – als Impulsgeber:innen für neue Geschäftsmodelle, als Vermittler:innen zwischen Disziplinen oder als Treiber:innen systemischer Veränderung."
            }
          }
        ],
        "Color": "default"
      }
    },
    {
