              "Bold": false,
              "Italic": false,
              "Strikethrough": false,
              "Underline": false,
              "Code": false,
              "Color": "default"
            },
            "PlainText": "Vom Wissen zur wirksamen Umsetzung",
            "Href": null,
            "Text": {
              "Content": "Vom Wissen zur wirksamen Umsetzung"
            }
          }
        ],
        "Color": "default",
        "IsToggleable": false
      }
    },
    {
      "Id": "34acc54c-ec6d-8074-9106-cfe8753cee4a",
      "Type": "paragraph",
      "HasChildren": false,
      "ParentId": "28ccc54c-ec6d-80fb-9d95-cff4eafc32f0",
      "Paragraph": {
        "RichTexts": [
          {
            "Annotation": {
              "Bold": false,
              "Italic": false,
              "Strikethrough": false,
              "Underline": false,
              "Code": false,
              "Color": "default"
            },
            "PlainText": "Ein zentrales Thema des Vortrags war die Frage, wann Nachhaltigkeit im Bauwesen tatsächlich Wirkung entfaltet. Die Antwort: erst dann, wenn sie in bestehende Prozesse, Geschäftsmodelle und Entscheidungsstrukturen integriert wird. Die Bauwende scheitert selten am fehlenden Wissen, sondern daran, wie wir Projekte organisieren, Entscheidungen treffen und Innovationen in die Praxis überführen.",
            "Href": null,
            "Text": {
              "Content": "Ein zentrales Thema des Vortrags war die Frage, wann Nachhaltigkeit im Bauwesen tatsächlich Wirkung entfaltet. Die Antwort: erst dann, wenn sie in bestehende Prozesse, Geschäftsmodelle und Entscheidungsstrukturen integriert wird. Die Bauwende scheitert selten am fehlenden Wissen, sondern daran, wie wir Projekte organisieren, Entscheidungen treffen und Innovationen in die Praxis überführen."
            }
          }
        ],
        "Color": "default"
      }
    },
    {
      "Id": "34acc54c-ec6d-8034-94a7-d8c20ee1de8f",
      "Type": "heading_2",
      "HasChildren": false,
      "ParentId": "28ccc54c-ec6d-80fb-9d95-cff4eafc32f0",
      "Heading2": {
        "RichTexts": [
          {
            "Annotation": {
