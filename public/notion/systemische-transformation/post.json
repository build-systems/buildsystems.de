              "Strikethrough": false,
              "Underline": false,
              "Code": false,
              "Color": "default"
            },
            "PlainText": "Neue Rollen in der Architektur",
            "Href": null,
            "Text": {
              "Content": "Neue Rollen in der Architektur"
            }
          }
        ],
        "Color": "default",
        "IsToggleable": false
