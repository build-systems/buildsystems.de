              "Strikethrough": false,
              "Underline": false,
              "Code": false,
              "Color": "default"
            },
            "PlainText": "Innovationsstrategien, nachhaltige Planung und Transferformate",
            "Href": null,
            "Text": {
              "Content": "Innovationsstrategien, nachhaltige Planung und Transferformate"
            }
          },
          {
            "Annotation": {
              "Bold": false,
              "Italic": false,
              "Strikethrough": false,
              "Underline": false,
              "Code": false,
              "Color": "default"
            },
            "PlainText": " unterstützen wir Unternehmen und Organisationen dabei, Transformation strukturiert zu gestalten – von der strategischen Ausrichtung über die konkrete Umsetzung bis zur Verankerung im Markt.",
            "Href": null,
            "Text": {
              "Content": " unterstützen wir Unternehmen und Organisationen dabei, Transformation strukturiert zu gestalten – von der strategischen Ausrichtung über die konkrete Umsetzung bis zur Verankerung im Markt."
            }
          }
        ],
        "Color": "default"
